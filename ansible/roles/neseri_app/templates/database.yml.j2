{{ ansible_managed | comment }}
#
# Lives at shared/config/database.yml and is symlinked into every release,
# overriding the repo's own config/database.yml (which points at a local
# Postgres via docker-compose.yml for development/test - see there). Only
# `production` matters here; this template exists instead of just deploying
# the repo's own config/database.yml so DATABASE_URL is required (ENV.fetch
# raises loudly if unset, instead of silently connecting nowhere).

production:
  adapter: postgresql
  encoding: unicode
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
  url: <%= ENV.fetch("DATABASE_URL") %>
