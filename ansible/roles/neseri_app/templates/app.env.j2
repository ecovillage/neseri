{{ ansible_managed | comment }}
#
# EnvironmentFile for the neseri-puma systemd unit. The Rails master key is
# NOT in here - it lives at shared/config/master.key, which Rails reads
# automatically, so it doesn't need to be threaded through the environment
# for both this file and the asset-precompile step.
{% for key, value in neseri_app_env.items() %}
{{ key }}={{ value }}
{% endfor %}
