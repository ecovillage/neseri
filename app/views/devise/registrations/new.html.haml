%h1.title= t('devise.registrations.new.sign_up')

= form_for(resource, as: resource_name, url: registration_path(resource_name), builder: SignUpFormBuilder) do |f|
  = f.errors

  .box
    %p.help= t(:required_fields_hint)
    = f.labeled_email_field :email
    = f.labeled_password_field :password, help_text: (t('devise.shared.minimum_password_length', count: @minimum_password_length) if @minimum_password_length)
    = f.labeled_password_field :password_confirmation

    .field
      = f.check_box :tos_agreement
      = f.label :tos_agreement, t(:read_and_accepted_tos_html, privacy_path: privacy_path)

  = f.submit t('devise.registrations.new.sign_up')

= render "devise/shared/links"
