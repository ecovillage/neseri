%h1.title= t('devise.registrations.new.sign_up')

= form_for(resource, as: resource_name, url: registration_path(resource_name), builder: BulmaFormBuilder::HorizontalBulmaFormBuilder) do |f|
  = f.errors

  .box
    = f.labeled_email_field :email
    = f.labeled_text_field :firstname, placeholder: t('instructor.placeholder.firstname')
    = f.labeled_text_field :lastname, placeholder: t('instructor.placeholder.lastname')
    = f.labeled_text_area :address, help_text: t('instructor.helptext.address')
    = f.labeled_text_field :phone, icon: 'fa-phone'
    = f.labeled_text_field :mobile, icon: 'fa-mobile'
    = f.labeled_text_field :homepage
    = f.labeled_password_field :password, help_text: (t('devise.shared.minimum_password_length', count: @minimum_password_length) if @minimum_password_length)
    = f.labeled_password_field :password_confirmation

    .field
      = f.check_box :tos_agreement
      = f.label :tos_agreement, t(:read_and_accepted_tos_html, privacy_path: privacy_path)

  = f.submit t('devise.registrations.new.sign_up')

= render "devise/shared/links"
